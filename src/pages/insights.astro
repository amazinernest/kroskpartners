---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ARTICLES } from '../data/articles';
---

<BaseLayout
  title="Market Intelligence & Research | Krosk Partners Limited — Macro Commentary"
  description="Read tactical capital markets commentaries authored by CEO Olushola Adeniyi and senior desk brokers. In-depth analysis on DMO debt auctions, MPR hikes, and liquidity repricing."
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-separator">/</span>
        <span>Market Intelligence</span>
      </div>

      <div class="badge-eyebrow gold mb-3">
        <span class="badge-pill-dot"></span>
        TRADING FLOOR RESEARCH &amp; MACRO COMMENTARIES
      </div>

      <h1 class="page-title">
        Fixed Income Insights &amp; Market Commentaries
      </h1>

      <p class="page-subtitle">
        Proprietary tactical analysis on Debt Management Office (DMO) bond issuances, monetary policy rate hikes, yield curve steepeners, and cash liquidity dynamics across Nigeria.
      </p>
    </div>
  </section>

  <!-- Main Articles Feed Section -->
  <section class="articles-feed-section">
    <div class="container-narrow">
      <div class="articles-stack">
        {ARTICLES.map((article) => (
          <article class="article-full-card glass-card" id={article.slug}>
            <div class="article-card-header">
              <div class="tag-row">
                <span class="category-badge">{article.category}</span>
                <span class="desk-tag">{article.deskTag}</span>
              </div>
              <h2 class="article-headline">{article.title}</h2>
              <div class="author-byline">
                <div>By <strong class="author-name">{article.author}</strong> &bull; <span class="author-role">{article.authorRole}</span></div>
                <div class="article-pub-date">Published {article.date} &bull; {article.readTime}</div>
              </div>
            </div>

            <div class="article-card-body">
              {article.pullQuote && (
                <blockquote class="editorial-pullquote">
                  &ldquo;{article.pullQuote}&rdquo;
                </blockquote>
              )}

              <div class="article-paragraphs">
                {article.content.map((p) => (
                  <p>{p}</p>
                ))}
              </div>

              <div class="author-signoff">
                <div class="signoff-note">Good luck trading,</div>
                <div class="signoff-author">{article.author}</div>
                <div class="signoff-role">{article.authorRole}</div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Institutional Research Subscription -->
  <section class="subscription-section">
    <div class="container">
      <div class="subscribe-card glass-card text-center">
        <div class="badge-eyebrow gold mb-3">
          <span class="badge-pill-dot"></span>
          INSTITUTIONAL RUN DISTRIBUTION
        </div>
        <h2 class="sub-title">Receive Daily Fixed Income Runs &amp; Commentaries</h2>
        <p class="sub-desc">
          Delivered directly to institutional dealing desks, treasury officers, and chief investment officers prior to market open at 8:00 AM WAT.
        </p>

        <form class="sub-form" onsubmit="event.preventDefault(); alert('Subscribed to KPL Daily Market Run.'); this.reset();">
          <input
            type="email"
            class="form-input sub-input"
            placeholder="Enter institutional email (e.g. treasurer@bank.com)..."
            required
          />
          <button type="submit" class="btn btn-primary">
            <span>Subscribe to Desk Run</span>
            <span class="btn-arrow">&rarr;</span>
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 70px 0 50px 0;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 0%, rgba(0, 168, 107, 0.08) 0%, transparent 60%);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-family: var(--font-display);
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--color-gold-light);
  }

  .crumb-separator {
    color: rgba(0, 0, 0, 0.25);
  }

  .mb-3 { margin-bottom: 18px; }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    margin-bottom: 18px;
  }

  .page-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 820px;
    color: var(--text-secondary);
  }

  .articles-feed-section {
    padding: 70px 0 100px 0;
  }

  .articles-stack {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .article-full-card {
    padding: 44px;
    border-radius: var(--radius-xl);
    scroll-margin-top: 100px;
  }

  .article-card-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 24px;
    margin-bottom: 28px;
  }

  .tag-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .category-badge {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: rgba(0, 168, 107, 0.1);
    border: 1px solid rgba(0, 168, 107, 0.25);
    color: var(--color-emerald-deep);
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .desk-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .article-headline {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .author-byline {
    font-size: 0.88rem;
    color: var(--text-secondary);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .author-name {
    color: var(--color-gold-dark);
  }

  .author-role {
    color: var(--color-emerald-deep);
  }

  .article-pub-date {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .editorial-pullquote {
    background: #F8FAFC;
    border-left: 4px solid var(--color-gold-dark);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 20px 24px;
    margin: 24px 0;
    font-size: 1.12rem;
    font-style: italic;
    color: var(--text-primary);
    line-height: 1.6;
  }

  .article-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .author-signoff {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px dashed var(--border-subtle);
    font-family: var(--font-display);
  }

  .signoff-note {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .signoff-author {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-gold-dark);
  }

  .signoff-role {
    font-size: 0.85rem;
    color: var(--color-emerald-deep);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Subscription */
  .subscription-section {
    padding-bottom: 100px;
  }

  .subscribe-card {
    padding: 60px 40px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #FFFFFF;
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.04);
    max-width: 820px;
    margin: 0 auto;
  }

  .sub-title {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .sub-desc {
    max-width: 600px;
    margin: 0 auto 30px auto;
    font-size: 1rem;
  }

  .sub-form {
    display: flex;
    gap: 12px;
    max-width: 580px;
    margin: 0 auto;
    flex-wrap: wrap;
    justify-content: center;
  }

  .sub-input {
    flex: 1;
    min-width: 280px;
  }

  .text-center {
    text-align: center;
  }

  @media (max-width: 768px) {
    .article-full-card {
      padding: 28px 20px;
    }
    .subscribe-card {
      padding: 36px 20px;
    }
  }
</style>
