---
import type { Article } from '../data/articles';

interface Props {
  article: Article;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
---

<article class={`article-card glass-card ${featured ? 'featured' : ''}`}>
  <div class="article-thumb-wrapper">
    <img
      src={article.image}
      alt={article.title}
      class="article-thumb"
      loading="lazy"
      width="480"
      height="280"
    />
    <div class="article-category-tag">{article.category}</div>
  </div>

  <div class="article-content">
    <div class="article-meta">
      <span class="article-author">By {article.author}</span>
      <span class="meta-dot">&bull;</span>
      <span class="article-date">{article.date}</span>
      <span class="meta-dot">&bull;</span>
      <span class="article-time">{article.readTime}</span>
    </div>

    <h3 class="article-title">
      <a href={`/insights#${article.slug}`}>{article.title}</a>
    </h3>

    {article.pullQuote && (
      <blockquote class="article-quote">
        &ldquo;{article.pullQuote}&rdquo;
      </blockquote>
    )}

    <p class="article-excerpt">{article.excerpt}</p>

    <div class="article-footer">
      <a href={`/insights#${article.slug}`} class="read-link">
        <span>Read Market Commentary</span>
        <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .article-card:hover {
    transform: translateY(-5px);
    border-color: var(--border-gold);
  }

  .article-thumb-wrapper {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #F5F5F7;
  }

  .article-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }

  .article-card:hover .article-thumb {
    transform: scale(1.06);
  }

  .article-category-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(0, 168, 107, 0.25);
    color: var(--color-emerald-deep);
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .article-content {
    padding: 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .article-author {
    color: var(--color-gold-dark);
    font-weight: 600;
  }

  .meta-dot {
    color: var(--border-card);
  }

  .article-title {
    font-size: 1.35rem;
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .article-title a {
    color: var(--text-primary);
  }

  .article-title a:hover {
    color: var(--color-emerald-deep);
  }

  .article-quote {
    font-size: 0.88rem;
    font-style: italic;
    color: #475569;
    border-left: 3px solid var(--color-gold);
    padding-left: 12px;
    margin: 12px 0;
    line-height: 1.5;
  }

  .article-excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .article-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-emerald-deep);
    letter-spacing: 0.03em;
  }

  .read-link:hover .arrow {
    transform: translateX(4px);
  }

  .arrow {
    transition: transform var(--transition-fast);
  }
</style>
