---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeskCard from '../components/DeskCard.astro';
import YieldCalculator from '../components/YieldCalculator.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { TRADING_DESKS } from '../data/desks';
import { ARTICLES } from '../data/articles';
import { TRUST_PARTNERS } from '../data/marketData';
---

<BaseLayout
  title="Krosk Partners Limited — Institutional Fixed Income Inter-Dealer Broker"
  description="Associate Member Inter-Dealer Broker regulated by FMDQ OTC Securities Exchange. Providing two-way liquidity across Nigerian Bonds, T-Bills, Commercial Papers, and Eurobonds."
>
  <!-- =========================================================================
       HERO SECTION: High-Impact Visual & Institutional Authority
       ========================================================================= -->
  <section class="hero-section">
    <div class="hero-bg-overlay"></div>
    <div class="container hero-container">
      <div class="hero-content">
        <!-- Eyebrow Badge -->
        <div class="badge-eyebrow gold mb-4">
          <span class="badge-pill-dot"></span>
          FMDQ OTC SECURITIES EXCHANGE ASSOCIATE MEMBER (IDB)
        </div>

        <!-- Main Headline -->
        <h1 class="hero-title">
          Empowering Institutions with <span class="text-gradient-gold">Fixed Income</span> Innovation
        </h1>

        <!-- Subtitle -->
        <p class="hero-subtitle">
          Krosk Partners Limited bridges institutional wholesale liquidity, anonymous two-way price discovery, and confidential execution across Nigerian Sovereign Bonds, Treasury Bills, Commercial Papers, and USD Eurobonds.
        </p>

        <!-- CTA Action Buttons -->
        <div class="hero-actions">
          <button type="button" class="btn btn-primary" data-open-rfq data-desk="General Fixed Income">
            <span>Request Two-Way RFQ</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </button>
          <a href="#trading-desks" class="btn btn-secondary">
            <span>Explore Trading Desks</span>
          </a>
          <a href="/calculator" class="btn btn-secondary">
            <span>Yield Simulator</span>
          </a>
        </div>

        <!-- Live Institutional Stats Bar -->
        <div class="hero-stats-bar glass-card">
          <div class="stat-item">
            <span class="stat-number text-gradient-emerald">60+</span>
            <span class="stat-label">Dealing Members &amp; Counterparties</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number text-gradient-gold">T+0 / T+2</span>
            <span class="stat-label">DvP Settlement Cycles (CSCS)</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number text-gradient-emerald">100%</span>
            <span class="stat-label">Pre-Trade Anonymity Guaranteed</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number text-gradient-gold">4</span>
            <span class="stat-label">Dedicated Institutional Desks</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       TRUST MARQUEE: Counterparty & Regulatory Ecosystem
       ========================================================================= -->
  <section class="trust-marquee-section" aria-label="Regulatory and Institutional Partners">
    <div class="trust-marquee-inner">
      <div class="trust-track">
        {TRUST_PARTNERS.map((partner) => (
          <div class="trust-item">
            <span class="trust-dot"></span>
            <span>{partner}</span>
          </div>
        ))}
        {TRUST_PARTNERS.map((partner) => (
          <div class="trust-item" aria-hidden="true">
            <span class="trust-dot"></span>
            <span>{partner}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       STRATEGIC VALUE PROPOSITION: Why Dealing Members Choose KPL
       ========================================================================= -->
  <section class="value-section">
    <div class="container">
      <div class="section-header">
        <div class="badge-eyebrow">
          <span class="badge-pill-dot"></span>
          INSTITUTIONAL BROKERAGE EXCELLENCE
        </div>
        <h2 class="section-title">Wholesale Precision at Every Settlement Horizon</h2>
        <p class="section-subtitle">
          We combine cutting-edge market pricing intelligence with strict regulatory oversight, providing seamless execution for dealing banks and institutional asset managers.
        </p>
      </div>

      <div class="grid-4">
        <div class="value-card glass-card">
          <div class="value-icon">⚡</div>
          <h3 class="value-card-title">Deep Secondary Liquidity</h3>
          <p class="value-card-desc">
            Continuous two-way price discovery across FGN Benchmark Bonds, NTBs, and prime Corporate Commercial Papers with tight spreads.
          </p>
        </div>

        <div class="value-card glass-card">
          <div class="value-icon">🛡️</div>
          <h3 class="value-card-title">Pre-Trade Anonymity</h3>
          <p class="value-card-desc">
            Counterparty orders remain strictly confidential until trade matching, mitigating market impact and preventing adverse price slippage.
          </p>
        </div>

        <div class="value-card glass-card">
          <div class="value-icon">⚖️</div>
          <h3 class="value-card-title">FMDQ Regulatory Rigor</h3>
          <p class="value-card-desc">
            Full trade affirmation conforming with FMDQ OTC rules, Central Bank of Nigeria (CBN) directives, and CSCS DvP settlement standards.
          </p>
        </div>

        <div class="value-card glass-card">
          <div class="value-icon">📞</div>
          <h3 class="value-card-title">Direct Desk Connectivity</h3>
          <p class="value-card-desc">
            Direct telephone and STP messaging conduits to our senior debt brokers stationed on the Lekki Phase 1 trading floor.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       INSTITUTIONAL TRADING DESKS GRID
       ========================================================================= -->
  <section class="desks-section" id="trading-desks">
    <div class="container-large">
      <div class="section-header">
        <div class="badge-eyebrow gold">
          <span class="badge-pill-dot"></span>
          SPECIALIZED WHOLESALE COVERAGE
        </div>
        <h2 class="section-title">Four Institutional Trading Desks</h2>
        <p class="section-subtitle">
          Engineered to intermediate sovereign debt, money market liquidity, and cross-border currency instruments with unmatched execution rigor.
        </p>
      </div>

      <div class="grid-2 desks-grid">
        {TRADING_DESKS.map((desk) => (
          <DeskCard desk={desk} />
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       INTERACTIVE YIELD & SETTLEMENT SIMULATOR (CALCULATOR)
       ========================================================================= -->
  <section class="calculator-section" id="yield-calculator">
    <div class="container-large">
      <YieldCalculator />
    </div>
  </section>

  <!-- =========================================================================
       MARKET INTELLIGENCE & RESEARCH HIGHLIGHTS
       ========================================================================= -->
  <section class="insights-section">
    <div class="container">
      <div class="section-header">
        <div class="badge-eyebrow">
          <span class="badge-pill-dot"></span>
          TRADING FLOOR RESEARCH &amp; MACRO COMMENTARY
        </div>
        <h2 class="section-title">Proprietary Capital Markets Intelligence</h2>
        <p class="section-subtitle">
          Authored by CEO Olushola Adeniyi and senior desk traders, providing actionable macro analysis for chief investment officers and treasurers.
        </p>
      </div>

      <div class="grid-3">
        {ARTICLES.slice(0, 3).map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/insights" class="btn btn-secondary">
          <span>Explore All Research Briefings &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       CORPORATE PARENTAGE & PHILANTHROPIC PURPOSE
       ========================================================================= -->
  <section class="parentage-section">
    <div class="container">
      <div class="parentage-card glass-card">
        <div class="parentage-content">
          <div class="badge-eyebrow gold">
            <span class="badge-pill-dot"></span>
            CORPORATE HOLDING ENTERPRISE
          </div>
          <h2 class="parentage-title">A Proud Subsidiary of Drosk Company Limited (DCL)</h2>
          <p class="parentage-text">
            Krosk Partners Limited operates as the premier financial services arm of <strong>Drosk Company Limited (DCL)</strong>, a diversified African investment enterprise. Through our shared leadership and the <strong>Drosk Development Foundation</strong>, we remain committed to socioeconomic empowerment and sustainable capital markets development.
          </p>
          <div class="parentage-actions">
            <a href="/about" class="btn btn-primary">
              <span>Read Corporate Profile</span>
              <span class="btn-arrow">&rarr;</span>
            </a>
            <a href="/about#team" class="btn btn-secondary">
              <span>Meet the Executive Team</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    padding-top: 80px;
    padding-bottom: 90px;
    overflow: hidden;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 10%, rgba(0, 168, 107, 0.06) 0%, transparent 60%),
      radial-gradient(circle at 80% 40%, rgba(245, 158, 11, 0.04) 0%, transparent 50%),
      url('/assets/images/template/680f3755b0d5d7c71655943e_brand-image-1.webp') center/cover no-repeat;
    opacity: 0.07;
    filter: saturate(0.4);
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
  }

  .mb-4 {
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    line-height: 1.08;
    margin-bottom: 24px;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 780px;
    margin: 0 auto 36px auto;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 60px;
  }

  .hero-stats-bar {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 28px 36px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    background: #FFFFFF;
    border-radius: var(--radius-xl);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-number {
    font-family: var(--font-hero);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border-subtle);
  }

  /* Trust Marquee */
  .trust-marquee-section {
    background: #F5F5F7;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding: 16px 0;
    overflow: hidden;
  }

  .trust-marquee-inner {
    overflow: hidden;
    white-space: nowrap;
  }

  .trust-track {
    display: inline-flex;
    gap: 40px;
    animation: marqueeLoop 45s linear infinite;
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .trust-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-emerald);
  }

  /* Value Section */
  .value-section {
    padding: 100px 0;
  }

  .value-card {
    padding: 32px 24px;
    border-radius: var(--radius-lg);
  }

  .value-icon {
    font-size: 2.2rem;
    margin-bottom: 18px;
  }

  .value-card-title {
    font-size: 1.25rem;
    margin-bottom: 10px;
  }

  .value-card-desc {
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* Desks Section */
  .desks-section {
    padding: 80px 0 100px 0;
    background: #F5F5F7;
  }

  /* Calculator Section */
  .calculator-section {
    padding: 60px 0 100px 0;
  }

  /* Insights Section */
  .insights-section {
    padding: 80px 0 100px 0;
  }

  .mt-8 {
    margin-top: 48px;
  }

  .text-center {
    text-align: center;
  }

  /* Parentage Section */
  .parentage-section {
    padding-bottom: 100px;
  }

  .parentage-card {
    padding: 50px;
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
  }

  .parentage-content {
    max-width: 820px;
  }

  .parentage-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    margin-top: 14px;
    margin-bottom: 16px;
  }

  .parentage-text {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 30px;
  }

  .parentage-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero-stats-bar {
      flex-direction: column;
      gap: 20px;
      padding: 24px;
    }
    .stat-divider {
      width: 80%;
      height: 1px;
    }
    .parentage-card {
      padding: 30px 24px;
    }
  }
</style>
