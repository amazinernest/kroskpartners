---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Trading Desks', href: '/services' },
  { label: 'Calculator', href: '/calculator' },
  { label: 'Insights', href: '/insights' },
  { label: 'Contact', href: '/contact' }
];

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="site-header" id="siteHeader">
  <div class="header-inner container-large">
    <!-- Brand Logo -->
    <a href="/" class="header-logo-link" aria-label="Krosk Partners Limited Home">
      <img
        src="/assets/images/brand/krosk-logo-dark.svg"
        alt="Krosk Partners Limited"
        class="header-logo-img"
        width="220"
        height="30"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`nav-link ${isActive(link.href) ? 'active' : ''}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Direct Hotline, RFQ Button, & Mobile Hamburger) -->
    <div class="header-actions">
      <!-- Direct Hotline Pill (Desktop only) -->
      <a href="tel:+2348038018023" class="hotline-pill" aria-label="Call Trading Floor Direct">
        <span class="hotline-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
        <span class="hotline-text">+234 803 801 8023</span>
      </a>

      <!-- RFQ Modal Trigger Button -->
      <button type="button" class="btn btn-primary btn-sm rfq-nav-btn" data-open-rfq data-desk="Fixed Income">
        <span>Request RFQ</span>
        <span class="btn-arrow" aria-hidden="true">&rarr;</span>
      </button>

      <!-- Prominent Mobile Hamburger Toggle -->
      <button
        type="button"
        class="mobile-toggle"
        id="mobileMenuToggle"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        aria-controls="mobileMenuPanel"
      >
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Panel -->
  <div class="mobile-menu-panel" id="mobileMenuPanel">
    <div class="mobile-menu-content">
      <div class="mobile-status-row">
        <span class="status-pulse-dot"></span>
        <span>WHOLESALE FIXED INCOME BROKERAGE</span>
      </div>

      <nav class="mobile-nav" aria-label="Mobile Navigation">
        <ul class="mobile-nav-list">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`mobile-nav-link ${isActive(link.href) ? 'active' : ''}`}
              >
                <span class="nav-label">{link.label}</span>
                <span class="nav-arrow">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-menu-actions">
        <a href="tel:+2348038018023" class="btn btn-secondary w-full" style="justify-content: center; margin-bottom: 12px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          Call Trading Floor: +234 803 801 8023
        </a>

        <button type="button" class="btn btn-primary w-full" data-open-rfq data-desk="Mobile RFQ">
          <span>Request Two-Way Quote</span>
          <span class="btn-arrow">&rarr;</span>
        </button>
      </div>

      <div class="mobile-menu-footer">
        <div>FMDQ OTC SECURITIES EXCHANGE ASSOCIATE MEMBER</div>
        <div>6, TUNDE FISAYO STREET, LEKKI PHASE 1, LAGOS</div>
      </div>
    </div>
  </div>
</header>

<script>
  function initHeaderMenu() {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const menuPanel = document.getElementById('mobileMenuPanel');
    const header = document.getElementById('siteHeader');

    if (!toggleBtn || !menuPanel) return;

    function openMenu() {
      menuPanel.classList.add('is-open');
      toggleBtn.classList.add('is-active');
      toggleBtn.setAttribute('aria-expanded', 'true');
      header?.classList.add('menu-open');
    }

    function closeMenu() {
      menuPanel.classList.remove('is-open');
      toggleBtn.classList.remove('is-active');
      toggleBtn.setAttribute('aria-expanded', 'false');
      header?.classList.remove('menu-open');
    }

    function toggleMenu(e: Event) {
      e.stopPropagation();
      if (menuPanel.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    toggleBtn.onclick = toggleMenu;

    // Close when clicking outside header
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && !target.closest('#siteHeader') && menuPanel.classList.contains('is-open')) {
        closeMenu();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuPanel.classList.contains('is-open')) {
        closeMenu();
      }
    });

    // Close menu when clicking on any nav link
    menuPanel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  // Ensure execution on immediate or ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderMenu);
  } else {
    initHeaderMenu();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background: #FFFFFF;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
    transition: background var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border-bottom-color: rgba(0, 0, 0, 0.12);
  }

  .site-header.menu-open {
    background: #FFFFFF !important;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 78px;
    padding-top: 4px;
    padding-bottom: 4px;
  }

  .header-logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header-logo-img {
    height: 30px;
    width: auto;
    object-fit: contain;
    transition: height var(--transition-fast);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #334155;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    letter-spacing: 0.01em;
  }

  .nav-link:hover {
    color: #040910;
    background: rgba(0, 0, 0, 0.05);
  }

  .nav-link.active {
    color: #00875A;
    background: rgba(0, 168, 107, 0.1);
    border: 1px solid rgba(0, 168, 107, 0.28);
    font-weight: 700;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .hotline-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    color: #1E293B;
    font-size: 0.84rem;
    font-family: var(--font-display);
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .hotline-pill:hover {
    border-color: var(--color-navy);
    color: var(--color-navy);
    background: var(--color-navy-tint);
  }

  .hotline-icon {
    color: var(--color-navy);
  }

  .btn-sm {
    padding: 9px 20px;
    font-size: 0.84rem;
  }

  /* Hamburger Toggle Button */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    cursor: pointer;
    padding: 0;
    transition: all var(--transition-fast);
    touch-action: manipulation;
    user-select: none;
    z-index: 1001;
  }

  .mobile-toggle:hover,
  .mobile-toggle:focus-visible {
    background: rgba(0, 168, 107, 0.08);
    border-color: var(--color-emerald);
    box-shadow: 0 0 14px rgba(0, 168, 107, 0.2);
    outline: none;
  }

  .toggle-bar {
    display: block;
    width: 22px;
    height: 2.5px;
    background-color: #0F172A;
    border-radius: 2px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, background-color 0.2s ease;
    transform-origin: center;
  }

  /* Animated X state */
  .mobile-toggle.is-active .toggle-bar:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
    background-color: var(--color-emerald);
  }

  .mobile-toggle.is-active .toggle-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-toggle.is-active .toggle-bar:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
    background-color: var(--color-emerald);
  }

  /* =========================================================================
     MOBILE MENU DROPDOWN PANEL
     ========================================================================= */
  .mobile-menu-panel {
    display: none;
    background: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    border-bottom: 3px solid var(--color-emerald);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12);
    max-height: calc(100vh - 78px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-menu-panel.is-open {
    display: block;
    animation: slideDownMenu 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideDownMenu {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-menu-content {
    padding: 24px 20px 32px 20px;
    display: flex;
    flex-direction: column;
    max-width: 600px;
    margin: 0 auto;
  }

  .mobile-status-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(0, 168, 107, 0.08);
    border: 1px solid rgba(0, 168, 107, 0.25);
    color: #00875A;
    font-size: 0.72rem;
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 18px;
    width: fit-content;
  }

  .status-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-emerald);
    box-shadow: 0 0 8px var(--color-emerald);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    padding: 13px 18px;
    border-radius: var(--radius-md);
    color: #1E293B;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    transition: all var(--transition-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-navy);
    background: var(--color-navy-tint);
    border-color: rgba(8, 20, 38, 0.2);
  }

  .nav-arrow {
    font-size: 1.15rem;
    color: var(--color-navy);
    transition: transform var(--transition-fast);
  }

  .mobile-nav-link:hover .nav-arrow {
    transform: translateX(4px);
  }

  .mobile-menu-actions {
    padding-top: 18px;
    border-top: 1px solid #E2E8F0;
    margin-bottom: 20px;
  }

  .mobile-menu-actions .btn-secondary {
    background: #F1F5F9;
    color: #0F172A;
    border: 1px solid #CBD5E1;
  }

  .mobile-menu-actions .btn-secondary:hover {
    background: #E2E8F0;
    color: #000000;
  }

  .w-full {
    width: 100%;
  }

  .mobile-menu-footer {
    font-size: 0.7rem;
    font-family: var(--font-display);
    color: #64748B;
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1.4;
    text-align: center;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .desktop-nav {
      display: none !important;
    }
    .hotline-pill {
      display: none !important;
    }
    .mobile-toggle {
      display: flex !important;
    }
  }

  @media (max-width: 768px) {
    .header-inner {
      height: 66px;
      padding-left: 16px;
      padding-right: 16px;
    }
    .header-logo-img {
      height: 26px;
      width: auto;
    }
    .rfq-nav-btn {
      padding: 7px 14px;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      height: 60px;
      padding-left: 14px;
      padding-right: 14px;
    }
    .header-logo-img {
      height: 24px;
      width: auto;
    }
    .rfq-nav-btn {
      display: none !important;
    }
  }
</style>
