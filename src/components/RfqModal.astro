---
---

<div
  class="modal-overlay"
  id="rfqModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rfqModalTitle"
>
  <div class="modal-window">
    <button
      type="button"
      class="modal-close-btn"
      id="rfqModalClose"
      aria-label="Close dialog"
    >
      &times;
    </button>

    <div class="modal-header">
      <div class="badge-eyebrow">
        <span class="badge-pill-dot"></span>
        FMDQ OTC INTER-DEALER BROKERAGE
      </div>
      <h2 id="rfqModalTitle" class="modal-title">Request Two-Way Institutional Quote</h2>
      <p class="modal-desc">
        Direct confidential order transmission to licensed debt brokers at 6, Tunde Fisayo Street, Lekki Phase 1, Lagos. Pre-trade anonymity strictly enforced.
      </p>
    </div>

    <!-- Active RFQ Mandate Form -->
    <form id="rfqMandateForm" class="rfq-form">
      <div class="form-group">
        <label for="rfqEntityName" class="form-label">Dealing Member / Institution Name *</label>
        <input
          type="text"
          id="rfqEntityName"
          name="entityName"
          class="form-input"
          placeholder="e.g. Stanbic IBTC Bank, ARM Pension Managers, Leadway Pensure"
          required
        />
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="rfqTraderName" class="form-label">Authorized Trader Name *</label>
          <input
            type="text"
            id="rfqTraderName"
            name="traderName"
            class="form-input"
            placeholder="Your Full Name"
            required
          />
        </div>

        <div class="form-group">
          <label for="rfqEntityCategory" class="form-label">Counterparty Category *</label>
          <select id="rfqEntityCategory" name="category" class="form-select" required>
            <option value="PFA">Pension Fund Administrator (PFA)</option>
            <option value="Bank">FMDQ Licensed Dealing Bank</option>
            <option value="AssetManager">Institutional Asset Manager</option>
            <option value="Insurance">Insurance / Corporate Treasury</option>
            <option value="ForeignInvestor">Foreign Portfolio Investor (FPI)</option>
          </select>
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="rfqDeskSelect" class="form-label">Trading Desk *</label>
          <select id="rfqDeskSelect" name="desk" class="form-select" required>
            <option value="Government & Corporate Bonds">Government &amp; Corporate Bonds Desk</option>
            <option value="Treasury Bills">Treasury Bills Desk (NTBs / OMO)</option>
            <option value="Money Market & Commercial Papers">Money Market &amp; Commercial Papers</option>
            <option value="Nigerian Eurobonds (USD)">Nigerian Eurobonds (USD)</option>
            <option value="General Fixed Income">General Fixed Income Wholesale</option>
          </select>
        </div>

        <div class="form-group">
          <label for="rfqMandateType" class="form-label">Mandate Intent *</label>
          <select id="rfqMandateType" name="mandateType" class="form-select" required>
            <option value="Two-Way Quote">Two-Way Price Discovery (Bid/Offer)</option>
            <option value="Firm Buy Order">Firm Buy Order (Bid)</option>
            <option value="Firm Sell Order">Firm Sell Order (Offer)</option>
            <option value="Relative Value Switch">Relative Value / Duration Switch</option>
          </select>
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="rfqNotional" class="form-label">Nominal Volume / Face Value *</label>
          <input
            type="text"
            id="rfqNotional"
            name="notional"
            class="form-input"
            placeholder="e.g. ₦100,000,000 or $500,000"
            required
          />
        </div>

        <div class="form-group">
          <label for="rfqPhone" class="form-label">Desk Telephone / Bloomberg ID *</label>
          <input
            type="text"
            id="rfqPhone"
            name="phone"
            class="form-input"
            placeholder="+234 ... or BBG UUID"
            required
          />
        </div>
      </div>

      <button type="submit" class="btn btn-emerald w-full" style="justify-content: center; padding: 15px 24px;">
        <span>Transmit Order Mandate to Trading Desk</span>
        <span class="btn-arrow">&rarr;</span>
      </button>

      <div class="rfq-footnote">
        Transmissions during trading hours (8:00 AM – 5:00 PM WAT) are answered on your dealer line within 5 minutes.
      </div>
    </form>

    <!-- Transmitted Confirmation State -->
    <div id="rfqSuccessState" class="rfq-success" style="display: none;">
      <div class="success-icon">&#10003;</div>
      <h3 class="success-title">Order Mandate Transmitted</h3>
      <p class="success-desc">
        Your institutional RFQ has been securely routed to our registered brokers on the Lekki Phase 1 trading floor. A senior broker will establish contact through your direct institutional dealer line or Bloomberg chat.
      </p>

      <div class="ticket-receipt">
        <div class="ticket-row">
          <span>TICKET REFERENCE:</span>
          <strong id="rfqTicketRef" class="ticket-code">KPL-829145</strong>
        </div>
        <div class="ticket-row">
          <span>INSTITUTION:</span>
          <strong id="rfqConfirmEntity">Dealing Member</strong>
        </div>
        <div class="ticket-row">
          <span>DESK ROUTED:</span>
          <strong id="rfqConfirmDesk">Fixed Income Desk</strong>
        </div>
        <div class="ticket-row">
          <span>CLEARING PROTOCOL:</span>
          <strong>CSCS / FMDQ OTC Affirmation</strong>
        </div>
      </div>

      <div class="success-actions">
        <a href="tel:+2348038018023" class="btn btn-secondary">
          <span>Dial Desk: +234 803 801 8023</span>
        </a>
        <button type="button" class="btn btn-primary" onclick="document.getElementById('rfqModal').classList.remove('active')">
          <span>Done</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-header {
    margin-bottom: 24px;
  }

  .modal-title {
    margin-top: 12px;
    margin-bottom: 8px;
    font-size: 1.85rem;
  }

  .modal-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .rfq-form {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rfq-footnote {
    font-size: 0.76rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 12px;
  }

  .rfq-success {
    text-align: center;
    padding: 24px 8px;
  }

  .success-icon {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(0, 168, 107, 0.15);
    border: 2px solid var(--color-emerald);
    color: var(--color-emerald-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    margin: 0 auto 20px auto;
    box-shadow: 0 0 30px var(--color-emerald-glow);
  }

  .success-title {
    font-size: 1.75rem;
    margin-bottom: 8px;
  }

  .success-desc {
    font-size: 0.95rem;
    max-width: 500px;
    margin: 0 auto 24px auto;
  }

  .ticket-receipt {
    background: #F8FAFC;
    border: 1px dashed rgba(0, 135, 90, 0.35);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    max-width: 460px;
    margin: 0 auto 28px auto;
    text-align: left;
    font-family: var(--font-display);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ticket-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .ticket-row strong {
    color: var(--text-primary);
  }

  .ticket-code {
    color: var(--color-gold-dark) !important;
    letter-spacing: 0.08em;
  }

  .success-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
