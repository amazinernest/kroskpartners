---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Pre-footer CTA Strip -->
  <div class="footer-cta-strip">
    <div class="container-large">
      <div class="cta-inner glass-card">
        <div class="cta-content">
          <div class="badge-eyebrow gold">
            <span class="badge-pill-dot"></span>
            CONFIDENTIAL TWO-WAY WHOLESALE LIQUIDITY
          </div>
          <h2 class="cta-title">Execute Fixed Income Transactions with Institutional Precision</h2>
          <p class="cta-desc">Direct wholesale access for FMDQ-licensed dealing banks, PFAs, and asset managers across Sovereign Bonds, Treasury Bills, Commercial Papers, and Nigerian Eurobonds.</p>
        </div>
        <div class="cta-buttons">
          <button type="button" class="btn btn-primary" data-open-rfq data-desk="Fixed Income Wholesale">
            <span>Request Two-Way Quote</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </button>
          <a href="tel:+2348038018023" class="btn btn-secondary">
            <span>Call Trading Floor</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="footer-main">
    <div class="container-large">
      <div class="footer-grid">
        <!-- Col 1: Brand & Firm Profile -->
        <div class="footer-col brand-col">
          <a href="/" class="footer-logo">
            <img
              src="/assets/images/brand/krosk-logo-dark.svg"
              alt="Krosk Partners Limited"
              width="220"
              height="28"
            />
          </a>
          <p class="footer-bio">
            Krosk Partners Limited is an Associate Member Inter-Dealer Broker operating under the regulatory supervision of the <strong>FMDQ OTC Securities Exchange</strong>. A flagship subsidiary of <strong>Drosk Company Limited (DCL)</strong>.
          </p>
          <div class="footer-status-pill">
            <span class="status-dot"></span>
            <span>Regulated FMDQ OTC Associate Member IDB</span>
          </div>
        </div>

        <!-- Col 2: Institutional Desks -->
        <div class="footer-col">
          <h3 class="footer-heading">Trading Desks</h3>
          <ul class="footer-links">
            <li><a href="/services#bonds">Government &amp; Corporate Bonds</a></li>
            <li><a href="/services#tbills">Treasury Bills (NTBs &amp; OMO)</a></li>
            <li><a href="/services#moneymarket">Commercial Papers &amp; Money Market</a></li>
            <li><a href="/services#eurobonds">Nigerian Eurobonds (USD)</a></li>
            <li><a href="/calculator">Yield &amp; Settlement Calculator</a></li>
            <li><a href="/services">Wholesale Execution Mandates</a></li>
          </ul>
        </div>

        <!-- Col 3: Firm & Governance -->
        <div class="footer-col">
          <h3 class="footer-heading">Firm &amp; Governance</h3>
          <ul class="footer-links">
            <li><a href="/about">Corporate Profile &amp; Pedigree</a></li>
            <li><a href="/about#team">Executive Leadership Team</a></li>
            <li><a href="/about#governance">FMDQ Regulatory Standards</a></li>
            <li><a href="/about#parent">Drosk Company Limited (DCL)</a></li>
            <li><a href="/insights">Trading Floor Intelligence</a></li>
            <li><a href="/contact">Counterparty Onboarding</a></li>
          </ul>
        </div>

        <!-- Col 4: Trading Floor Directory -->
        <div class="footer-col">
          <h3 class="footer-heading">Trading Floor Directory</h3>
          <address class="footer-address">
            <div class="address-item">
              <span class="address-icon">📍</span>
              <div>
                <strong>Headquarters &amp; Dealing Desk:</strong><br />
                6, Tunde Fisayo Street, Off Babatunde Anjous Avenue, Lekki Phase 1, Lagos State, Nigeria.
              </div>
            </div>
            <div class="address-item">
              <span class="address-icon">📞</span>
              <div>
                <strong>Direct Desk Telephone:</strong><br />
                <a href="tel:+2348038018023" class="highlight-link">+234 803 801 8023</a>
              </div>
            </div>
            <div class="address-item">
              <span class="address-icon">✉️</span>
              <div>
                <strong>Institutional Order Routing:</strong><br />
                <a href="mailto:Info@kroskpartners.com" class="highlight-link">Info@kroskpartners.com</a>
              </div>
            </div>
            <div class="address-meta">
              Desk Hours: 8:00 AM – 5:00 PM WAT (Monday – Friday)
            </div>
          </address>
        </div>
      </div>

      <!-- Footer Bottom Copyright & Compliance -->
      <div class="footer-bottom">
        <div class="bottom-copy">
          &copy; {currentYear} Krosk Partners Limited (KPL). All rights reserved. Associate Member Inter-Dealer Broker.
        </div>
        <div class="bottom-disclaimer">
          FMDQ OTC Securities Exchange Licensed &bull; Central Bank of Nigeria Supervised Ecosystem &bull; CSCS DvP Settlement
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #F5F5F7;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    position: relative;
    overflow: hidden;
  }

  .footer-cta-strip {
    padding-top: 60px;
    padding-bottom: 40px;
  }

  .cta-inner {
    padding: 48px;
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-title {
    margin-top: 12px;
    margin-bottom: 12px;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    color: #1D1D1F;
  }

  .cta-desc {
    max-width: 650px;
    font-size: 1.05rem;
    color: #6E6E73;
  }

  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex-shrink: 0;
  }

  .footer-main {
    padding-top: 50px;
    padding-bottom: 30px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 60px;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 20px;
  }

  .footer-logo img {
    height: 28px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .footer-bio {
    font-size: 0.92rem;
    line-height: 1.7;
    margin-bottom: 20px;
    color: #6E6E73;
  }

  .footer-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(0, 168, 107, 0.08);
    border: 1px solid rgba(0, 168, 107, 0.2);
    color: #00875A;
    font-size: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-emerald);
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1D1D1F;
    margin-bottom: 22px;
    position: relative;
    padding-bottom: 10px;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--color-emerald);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links a {
    color: #6E6E73;
    font-size: 0.92rem;
    transition: all var(--transition-fast);
  }

  .footer-links a:hover {
    color: #00875A;
    transform: translateX(4px);
  }

  .footer-address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 0.9rem;
    color: #6E6E73;
    line-height: 1.6;
  }

  .address-item {
    display: flex;
    gap: 12px;
  }

  .address-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    line-height: 1.4;
  }

  .highlight-link {
    color: #1D1D1F;
    font-weight: 700;
  }

  .highlight-link:hover {
    color: #00875A;
    text-decoration: underline;
  }

  .address-meta {
    font-size: 0.8rem;
    color: #86868B;
    border-top: 1px dashed rgba(0, 0, 0, 0.1);
    padding-top: 10px;
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.82rem;
    color: #86868B;
  }

  @media (max-width: 1024px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px;
    }
    .cta-buttons {
      width: 100%;
      flex-direction: row;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 640px) {
    .cta-buttons {
      flex-direction: column;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
