---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MarketTicker from '../components/MarketTicker.astro';
import RfqModal from '../components/RfqModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Krosk Partners Limited — Institutional Fixed Income Inter-Dealer Broker | FMDQ OTC Associate Member',
  description = 'Krosk Partners Limited (KPL) is an Associate Member Inter-Dealer Broker regulated by FMDQ OTC Securities Exchange, delivering two-way liquidity and execution across Nigerian Bonds, T-Bills, Commercial Papers, and Eurobonds.',
  ogImage = '/assets/images/brand/krosk-brand-dark.png'
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site || 'https://kroskpartners.com');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "FinancialService",
  "name": "Krosk Partners Limited",
  "alternateName": "KPL Inter-Dealer Broker",
  "url": "https://kroskpartners.com",
  "logo": "https://kroskpartners.com/assets/images/brand/krosk-logo-light.svg",
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "6, Tunde Fisayo Street, Off Babatunde Anjous Avenue, Lekki Phase 1",
    "addressLocality": "Lagos State",
    "addressCountry": "NG"
  },
  "telephone": "+2348038018023",
  "email": "Info@kroskpartners.com",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "17:00"
  },
  "memberOf": {
    "@type": "Organization",
    "name": "FMDQ OTC Securities Exchange"
  },
  "parentOrganization": {
    "@type": "Organization",
    "name": "Drosk Company Limited"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/images/brand/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/images/brand/favicon.png" />

  <!-- Open Graph / Social Meta -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter Meta -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</head>
<body>
  <!-- Real-time OTC Market Benchmarks Ticker -->
  <MarketTicker />

  <!-- Sticky Institutional Header -->
  <Header currentPath={currentPath} />

  <!-- Main Content Page Slot -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Institutional Footer -->
  <Footer />

  <!-- Global RFQ Modal Component -->
  <RfqModal />

  <!-- Client-side Application Scripts (TypeScript) -->
  <script>
    import { initApp } from '../scripts/main';
    document.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
