---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRADING_DESKS } from '../data/desks';
---

<BaseLayout
  title="Institutional Trading Desks | Krosk Partners Limited — Bonds, T-Bills, CPs, Eurobonds"
  description="Explore KPL's 4 specialized institutional trading desks: Government & Corporate Bonds, Treasury Bills, Money Market & Commercial Papers, and Nigerian Eurobonds (USD)."
>
  <!-- =========================================================================
       PAGE HERO
       ========================================================================= -->
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-separator">/</span>
        <span>Institutional Services</span>
      </div>

      <div class="badge-eyebrow mb-3">
        <span class="badge-pill-dot"></span>
        FOUR SPECIALIZED WHOLESALE COVERAGE DESKS
      </div>

      <h1 class="page-title">
        Wholesale Trade Intermediation &amp; Liquidity
      </h1>

      <p class="page-subtitle">
        Engineered for FMDQ-licensed dealing banks, Pension Fund Administrators (PFAs), and institutional asset managers seeking deep two-way liquidity, anonymous price discovery, and tight execution spreads.
      </p>
    </div>
  </section>

  <!-- =========================================================================
       DESKS QUICK NAV
       ========================================================================= -->
  <section class="desks-quick-nav">
    <div class="container">
      <div class="quick-nav-pill-group">
        {TRADING_DESKS.map((d) => (
          <a href={`#${d.id}`} class="quick-nav-pill">
            <span class="pill-num">DESK {d.number}</span>
            <span class="pill-name">{d.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       THE 4 INSTITUTIONAL DESKS (DETAILED BREAKDOWN)
       ========================================================================= -->
  <section class="desks-detail-section">
    <div class="container">
      <div class="desks-stack">
        {TRADING_DESKS.map((desk, idx) => (
          <article class={`desk-detailed-card glass-card ${idx % 2 === 1 ? 'reverse' : ''}`} id={desk.id}>
            <!-- Narrative Left -->
            <div class="desk-narrative">
              <div class="desk-eyebrow-row">
                <span class="badge-eyebrow">DESK {desk.number}</span>
                <span class="badge-eyebrow">FMDQ AFFIRMED</span>
              </div>

              <h2 class="desk-heading">{desk.title}</h2>
              <p class="desk-tagline-text">{desk.tagline}</p>
              <p class="desk-body">{desk.description}</p>

              <!-- Instruments Pill List -->
              <div class="instruments-box">
                <span class="box-title">Underlying Wholesale Instruments:</span>
                <ul class="instrument-bullets">
                  {desk.instruments.map((inst) => (
                    <li>{inst}</li>
                  ))}
                </ul>
              </div>

              <!-- Desk Action Button -->
              <div class="desk-cta-row">
                <button
                  type="button"
                  class="btn btn-primary"
                  data-open-rfq
                  data-desk={desk.rfqDeskName}
                >
                  <span>Request {desk.title} Run</span>
                  <span class="btn-arrow">&rarr;</span>
                </button>
                <a href="/calculator" class="btn btn-secondary">
                  <span>Simulate Yield</span>
                </a>
              </div>
            </div>

            <!-- Technical Specifications Table Right -->
            <div class="desk-specs-card">
              <div class="specs-header">
                <span class="specs-title">Trading Specifications &amp; Market Rules</span>
              </div>
              <div class="specs-table-wrapper">
                <table class="specs-table">
                  <tbody>
                    {desk.specs.map((spec) => (
                      <tr>
                        <td class="spec-col-label">{spec.label}</td>
                        <td class="spec-col-val">{spec.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="specs-footer-callout">
                <span class="icon">🛡️</span>
                <span>Pre-trade counterparty discretion strictly maintained until trade matching.</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       INSTITUTIONAL DvP TRADE LIFECYCLE
       ========================================================================= -->
  <section class="lifecycle-section">
    <div class="container">
      <div class="section-header">
        <div class="badge-eyebrow">
          <span class="badge-pill-dot"></span>
          AUDITABLE SETTLEMENT GOVERNANCE
        </div>
        <h2 class="section-title">Institutional Trade Affirmation &amp; DvP Workflow</h2>
        <p class="section-subtitle">
          From bilateral mandate receipt to ultimate CSCS securities delivery, our trade processing lifecycle guarantees zero settlement failures.
        </p>
      </div>

      <div class="lifecycle-steps grid-4">
        <div class="step-card glass-card">
          <div class="step-num text-gradient-gold">01</div>
          <h3 class="step-title">Mandate Receipt &amp; Price Discovery</h3>
          <p class="step-desc">
            Dealing member transmits notional volume, tenor, and yield preference via encrypted voice or STP messaging to our floor.
          </p>
        </div>

        <div class="step-card glass-card">
          <div class="step-num text-gradient-emerald">02</div>
          <h3 class="step-title">Anonymous Order Matching</h3>
          <p class="step-desc">
            Brokers match buy and sell interests across 60+ counterparty books without revealing institutional book identities.
          </p>
        </div>

        <div class="step-card glass-card">
          <div class="step-num text-gradient-gold">03</div>
          <h3 class="step-title">FMDQ STP Affirmation</h3>
          <p class="step-desc">
            Matched trade tickets are electronically submitted to FMDQ OTC reporting engines for instant affirmation and audit logging.
          </p>
        </div>

        <div class="step-card glass-card">
          <div class="step-num text-gradient-emerald">04</div>
          <h3 class="step-title">CSCS DvP Settlement</h3>
          <p class="step-desc">
            Direct Delivery versus Payment (DvP) through Central Securities Clearing System (CSCS) on standard T+0 or T+2 timeline.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 70px 0 50px 0;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 0%, rgba(0, 168, 107, 0.08) 0%, transparent 60%);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-family: var(--font-display);
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--color-gold-light);
  }

  .crumb-separator {
    color: rgba(0, 0, 0, 0.25);
  }

  .mb-3 { margin-bottom: 18px; }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    margin-bottom: 18px;
  }

  .page-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 820px;
    color: var(--text-secondary);
  }

  /* Desks Quick Nav */
  .desks-quick-nav {
    padding: 24px 0;
    background: rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    position: sticky;
    top: 78px;
    z-index: 30;
    backdrop-filter: blur(14px);
  }

  .quick-nav-pill-group {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .quick-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: var(--radius-full);
    background: #F5F5F7;
    border: 1px solid rgba(0, 0, 0, 0.06);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-family: var(--font-display);
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .quick-nav-pill:hover {
    background: rgba(0, 168, 107, 0.12);
    border-color: rgba(0, 168, 107, 0.35);
    color: var(--text-primary);
  }

  .pill-num {
    font-weight: 800;
    color: var(--color-gold-dark);
  }

  .pill-name {
    font-weight: 600;
  }

  /* Desks Stack */
  .desks-detail-section {
    padding: 80px 0 100px 0;
  }

  .desks-stack {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .desk-detailed-card {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    padding: 44px;
    border-radius: var(--radius-xl);
    scroll-margin-top: 160px;
  }

  .desk-detailed-card.reverse {
    grid-template-columns: 0.8fr 1.2fr;
  }

  .desk-detailed-card.reverse .desk-narrative {
    order: 2;
  }

  .desk-detailed-card.reverse .desk-specs-card {
    order: 1;
  }

  .desk-eyebrow-row {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 14px;
  }

  .desk-heading {
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    margin-bottom: 8px;
  }

  .desk-tagline-text {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-gold-dark);
    margin-bottom: 18px;
  }

  .desk-body {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 24px;
    color: var(--text-secondary);
  }

  .instruments-box {
    padding: 18px 22px;
    border-radius: var(--radius-md);
    background: #F8FAFC;
    border: 1px solid rgba(0, 0, 0, 0.06);
    margin-bottom: 30px;
  }

  .box-title {
    display: block;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-emerald-deep);
    margin-bottom: 10px;
  }

  .instrument-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .instrument-bullets li {
    font-size: 0.92rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .instrument-bullets li::before {
    content: '→';
    color: var(--color-gold-dark);
    font-weight: bold;
  }

  .desk-cta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Specifications Table */
  .desk-specs-card {
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .specs-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 14px;
    margin-bottom: 18px;
  }

  .specs-title {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .specs-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }

  .specs-table tr {
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .specs-table tr:last-child {
    border-bottom: none;
  }

  .spec-col-label {
    padding: 12px 0;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 600;
  }

  .spec-col-val {
    padding: 12px 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    text-align: right;
  }

  .specs-footer-callout {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.78rem;
    color: var(--text-secondary);
    background: rgba(0, 168, 107, 0.08);
    border: 1px solid rgba(0, 168, 107, 0.2);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }

  /* Lifecycle Section */
  .lifecycle-section {
    padding: 100px 0;
    background: #F5F5F7;
  }

  .step-card {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-family: var(--font-hero);
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 14px;
  }

  .step-title {
    font-size: 1.22rem;
    margin-bottom: 10px;
  }

  .step-desc {
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 991px) {
    .desk-detailed-card,
    .desk-detailed-card.reverse {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }
    .desk-detailed-card.reverse .desk-narrative {
      order: 1;
    }
    .desk-detailed-card.reverse .desk-specs-card {
      order: 2;
    }
  }
</style>
