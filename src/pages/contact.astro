---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Trading Floor Directory & Contact | Krosk Partners Limited — Lekki Phase 1, Lagos"
  description="Contact Krosk Partners Limited dealing desk at 6, Tunde Fisayo Street, Lekki Phase 1, Lagos. Direct dealer line: +234 803 801 8023. Submit institutional trading mandates."
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-separator">/</span>
        <span>Contact &amp; Desk Directory</span>
      </div>

      <div class="badge-eyebrow mb-3">
        <span class="badge-pill-dot"></span>
        DIRECT INSTITUTIONAL TRADING ACCESS
      </div>

      <h1 class="page-title">
        Trading Desks &amp; Directory
      </h1>

      <p class="page-subtitle">
        Direct communication channels for FMDQ-licensed dealing banks, Pension Fund Administrators (PFAs), asset managers, and institutional market participants.
      </p>
    </div>
  </section>

  <!-- Split Section: Contact Form & Dealing Floor Cards -->
  <section class="contact-split-section">
    <div class="container">
      <div class="contact-grid">
        <!-- Left: Mandate Form -->
        <div class="contact-form-side glass-card">
          <div class="badge-eyebrow mb-2">
            <span class="badge-pill-dot"></span>
            DISPATCH MANDATE
          </div>
          <h2 class="form-title">Send Institutional Mandate or Inquiry</h2>
          <p class="form-intro">
            Complete the secure transmission form below to route an inquiry or order mandate directly to our Lekki Phase 1 trading desk.
          </p>

          <form id="contactForm" class="actual-form" onsubmit="event.preventDefault(); alert('Inquiry successfully dispatched to KPL Trading Floor. A registered broker will contact you shortly.'); this.reset();">
            <div class="form-group">
              <label for="cEntity" class="form-label">Institution / Dealing Member Name *</label>
              <input
                type="text"
                id="cEntity"
                class="form-input"
                placeholder="e.g. Stanbic IBTC Bank, Leadway Pensure, ARM Asset"
                required
              />
            </div>

            <div class="grid-2">
              <div class="form-group">
                <label for="cTrader" class="form-label">Trader / Officer Name *</label>
                <input
                  type="text"
                  id="cTrader"
                  class="form-input"
                  placeholder="Your Full Name"
                  required
                />
              </div>

              <div class="form-group">
                <label for="cCategory" class="form-label">Institution Category *</label>
                <select id="cCategory" class="form-select" required>
                  <option value="PFA">Pension Fund Administrator (PFA)</option>
                  <option value="Bank">FMDQ Licensed Dealing Bank</option>
                  <option value="AssetManager">Asset Management Firm</option>
                  <option value="Insurance">Insurance / Corporate Treasury</option>
                  <option value="Other">Other Institutional Counterparty</option>
                </select>
              </div>
            </div>

            <div class="grid-2">
              <div class="form-group">
                <label for="cEmail" class="form-label">Official Email *</label>
                <input
                  type="email"
                  id="cEmail"
                  class="form-input"
                  placeholder="officer@institution.com"
                  required
                />
              </div>

              <div class="form-group">
                <label for="cPhone" class="form-label">Direct Desk Telephone *</label>
                <input
                  type="tel"
                  id="cPhone"
                  class="form-input"
                  placeholder="+234 ... or Bloomberg ID"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label for="cDesk" class="form-label">Target Desk / Department *</label>
              <select id="cDesk" class="form-select" required>
                <option value="Bonds">Government &amp; Corporate Bonds Desk</option>
                <option value="TBills">Treasury Bills Desk (NTBs / OMO)</option>
                <option value="MoneyMarket">Commercial Papers &amp; Money Market</option>
                <option value="Eurobonds">Nigerian Eurobonds Desk (USD)</option>
                <option value="Compliance">Compliance &amp; Counterparty Onboarding</option>
                <option value="General">General Inquiries &amp; Partnerships</option>
              </select>
            </div>

            <div class="form-group">
              <label for="cMessage" class="form-label">Transaction Parameters / Message *</label>
              <textarea
                id="cMessage"
                rows="4"
                class="form-textarea"
                placeholder="Specify your notional volume, target maturity, pricing preferences, or counterparty onboarding query..."
                required
              ></textarea>
            </div>

            <button type="submit" class="btn btn-emerald w-full" style="justify-content: center; padding: 15px 24px;">
              <span>Transmit Message to KPL Trading Floor</span>
              <span class="btn-arrow">&rarr;</span>
            </button>

            <div class="form-privacy-note">
              Dispatches received during trading hours (8:00 AM – 5:00 PM WAT) are answered on your dealer line within minutes.
            </div>
          </form>
        </div>

        <!-- Right: Trading Floor Cards -->
        <div class="contact-details-side">
          <!-- Main Desk Card -->
          <div class="info-card glass-card">
            <div class="badge-eyebrow mb-2">HEADQUARTERS &amp; DEALING FLOOR</div>
            <h3 class="info-card-title">Krosk Partners Limited</h3>
            
            <div class="info-rows">
              <div class="info-row">
                <span class="info-icon">📍</span>
                <div>
                  <div class="info-label">Dealing Floor Location:</div>
                  <div class="info-val">
                    6, Tunde Fisayo Street, Off Babatunde Anjous Avenue, Lekki Phase 1, Lagos State, Nigeria.
                  </div>
                </div>
              </div>

              <div class="info-row">
                <span class="info-icon">📞</span>
                <div>
                  <div class="info-label">Direct Desk Telephone:</div>
                  <div class="info-val">
                    <a href="tel:+2348038018023" class="highlight-link">+234 803 801 8023</a>
                  </div>
                </div>
              </div>

              <div class="info-row">
                <span class="info-icon">✉️</span>
                <div>
                  <div class="info-label">Institutional Order Routing:</div>
                  <div class="info-val">
                    <a href="mailto:Info@kroskpartners.com" class="highlight-link">Info@kroskpartners.com</a>
                  </div>
                </div>
              </div>

              <div class="info-row">
                <span class="info-icon">🕒</span>
                <div>
                  <div class="info-label">Active Trading Desk Hours:</div>
                  <div class="info-val">
                    8:00 AM – 5:00 PM WAT (Monday – Friday)<br />
                    <span style="font-size: 0.8rem; color: var(--color-emerald-light);">Conforming to FMDQ Secondary Market Hours</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <button type="button" class="btn btn-primary w-full" data-open-rfq data-desk="Fixed Income Wholesale">
                <span>Request Instant Two-Way RFQ</span>
                <span class="btn-arrow">&rarr;</span>
              </button>
            </div>
          </div>

          <!-- Counterparty Onboarding Card -->
          <div class="onboarding-card glass-card">
            <h4 class="onboard-title">FMDQ Member Counterparty Onboarding</h4>
            <p class="onboard-desc">
              Are you a licensed Dealing Bank, PFA, or Qualified Institutional Buyer looking to trade through Krosk Partners Limited? Complete your bilateral counterparty mandate setup in less than 24 hours.
            </p>
            <div class="onboard-reqs">
              <span>Required: FMDQ IDB Bilateral Brokerage Agreement &bull; Authorized Dealer Signatory Mandate &bull; CSCS DvP Account Details</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 70px 0 50px 0;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 0%, rgba(0, 168, 107, 0.08) 0%, transparent 60%);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-family: var(--font-display);
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--color-navy);
  }

  .crumb-separator {
    color: rgba(0, 0, 0, 0.25);
  }

  .mb-2 { margin-bottom: 12px; }
  .mb-3 { margin-bottom: 18px; }
  .mt-4 { margin-top: 24px; }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    margin-bottom: 18px;
  }

  .page-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 820px;
    color: var(--text-secondary);
  }

  .contact-split-section {
    padding: 80px 0 100px 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
    align-items: start;
  }

  .contact-form-side {
    padding: 40px;
    border-radius: var(--radius-xl);
  }

  .form-title {
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    margin-bottom: 10px;
  }

  .form-intro {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .actual-form {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-privacy-note {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 14px;
    line-height: 1.5;
  }

  .contact-details-side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .info-card {
    padding: 36px;
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .info-card-title {
    font-size: 1.6rem;
    margin-bottom: 22px;
  }

  .info-rows {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-row {
    display: flex;
    gap: 14px;
    font-size: 0.92rem;
  }

  .info-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
    line-height: 1.3;
  }

  .info-label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .info-val {
    color: var(--text-primary);
    line-height: 1.55;
  }

  .highlight-link {
    color: var(--color-navy);
    font-weight: 700;
  }

  .highlight-link:hover {
    text-decoration: underline;
  }

  .onboarding-card {
    padding: 30px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0, 135, 90, 0.25);
    background: #F8FAFC;
  }

  .onboard-title {
    font-size: 1.18rem;
    margin-bottom: 10px;
    color: var(--color-emerald-deep);
  }

  .onboard-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .onboard-reqs {
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px dashed var(--border-subtle);
    padding-top: 10px;
    line-height: 1.5;
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 991px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-form-side {
      padding: 28px 20px;
    }
  }
</style>
